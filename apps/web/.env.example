# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.
# Valores locales: los imprime `pnpm exec supabase status` en la raíz del repo.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Conexión directa a Postgres (solo servidor). En producción, usar el pooler de Supabase.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Protege /api/cron/* (lo envía el planificador como 'Authorization: Bearer <valor>').
CRON_SECRET=

# Emails. Sin RESEND_API_KEY se usa Mailpit (local, http://127.0.0.1:55324), que atrapa todo.
RESEND_API_KEY=
# Secreto del webhook de Resend (entregado / rebotado), formato whsec_...
RESEND_WEBHOOK_SECRET=
# Remitente: dominio verificado en Resend; el nombre es el de cada inmobiliaria.
EMAIL_FROM=avisos@rentavle.com
